<?xml version="1.0" encoding="utf-8"?>
<!-- The logo (branding/logo.svg) in the 66 dp safe zone of a 108 dp adaptive icon. The paths
     are the SVG's, in its 512-unit coordinates: the group scales them by 0.14 about the
     centre and moves them down 2.8 dp, so the clock with its bells sits centred. Strokes
     scale with the group. Design system §6. Also the monochrome layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.14"
        android:scaleY="0.14"
        android:translateX="-202"
        android:translateY="-199.2">
        <path
            android:pathData="M82,174.9 A192,192 0 0 1 174.9,82"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="26" />
        <path
            android:pathData="M337.1,82 A192,192 0 0 1 430,174.9"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="26" />
        <path
            android:pathData="M106,256 A150,150 0 1 1 406,256 A150,150 0 1 1 106,256 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="30" />
        <path
            android:pathData="M186,262 L236,312 L330,206"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="34" />
    </group>
</vector>
