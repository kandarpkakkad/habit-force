# Normalise text to LF in the repository. Shell scripts and gradlew must stay LF in
# every checkout: bash, in a container or on a CI runner, dies on the first \r.
* text=auto
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.jpg binary
*.tflite binary
*.onnx binary
*.dng binary
